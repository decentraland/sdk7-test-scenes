{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HTN",
  "scopeName": "source.htn",
  "comment": "Adapted from upstream htn_planner HTNVSCode/syntaxes/htn.tmLanguage.json (MIT, see LICENSE) for the dialect of tools/htn/lexer.ts: // comments, strings without escapes, :axiom, top_level_method, alt, not, task and call prefixes, qualified names, operators.",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#modifiers" },
    { "include": "#callterms" },
    { "include": "#keywords" },
    { "include": "#variables" },
    { "include": "#constants" },
    { "include": "#tasks" },
    { "include": "#qualified" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#parens" }
  ],
  "repository": {
    "comments": {
      "patterns": [{ "name": "comment.line.double-slash.htn", "match": "//.*$" }]
    },
    "strings": {
      "comment": "No escapes: a string ends at the next double quote and may span lines (HTNLexerBase.cpp LexString).",
      "patterns": [{ "name": "string.quoted.double.htn", "begin": "\"", "end": "\"" }]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(:\\s*domain)(?![A-Za-z0-9_])\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.other.declaration.htn" }, "2": { "name": "entity.name.type.domain.htn" } }
        },
        {
          "match": "(:\\s*(?:method|axiom))(?![A-Za-z0-9_])\\s*\\(\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.other.declaration.htn" }, "2": { "name": "entity.name.function.htn" } }
        },
        {
          "name": "keyword.other.declaration.htn",
          "match": ":\\s*(?:include|domain|method|axiom|constants)(?![A-Za-z0-9_])"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.htn",
          "match": "(?<![A-Za-z0-9_])(?:top_level_domain|top_level_method|base|overrides)(?![A-Za-z0-9_])"
        }
      ]
    },
    "callterms": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_])(call)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.control.htn" }, "2": { "name": "support.function.callterm.htn" } }
        }
      ]
    },
    "keywords": {
      "patterns": [{ "name": "keyword.control.htn", "match": "(?<![A-Za-z0-9_])(?:and|or|alt|not|call)(?![A-Za-z0-9_])" }]
    },
    "variables": {
      "patterns": [
        { "name": "variable.language.discard.htn", "match": "\\?any_[A-Za-z0-9_]*" },
        { "name": "variable.other.htn", "match": "\\?[A-Za-z_][A-Za-z0-9_]*" }
      ]
    },
    "constants": {
      "patterns": [{ "name": "constant.other.htn", "match": "@[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*" }]
    },
    "tasks": {
      "patterns": [
        { "name": "entity.name.function.primitive.htn", "match": "!(?!=)\\s*[A-Za-z_][A-Za-z0-9_]*" },
        { "name": "entity.name.function.axiom.htn", "match": "#\\s*[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*" },
        { "name": "entity.name.function.deferred.htn", "match": "&\\s*[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*" }
      ]
    },
    "qualified": {
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)(::)",
          "captures": { "1": { "name": "entity.name.namespace.htn" }, "2": { "name": "punctuation.separator.namespace.htn" } }
        }
      ]
    },
    "numbers": {
      "patterns": [{ "name": "constant.numeric.htn", "match": "(?<![A-Za-z0-9_])-?\\d+(?:\\.\\d+)?(?![A-Za-z0-9_])" }]
    },
    "operators": {
      "patterns": [{ "name": "keyword.operator.htn", "match": "==|!=|<=|>=|\\+\\+|--|[=<>+\\-*/%]" }]
    },
    "parens": {
      "patterns": [{ "name": "punctuation.section.parens.htn", "match": "[()]" }]
    }
  }
}
