(:include "bot_base.domain")

// Hug bot: greet the best person who wants a hug and was not hugged recently, walk up, hug, linger a second, mark
// them, say a parting line. Tampered with, it hits instead and says something mean.
//
// Teaches: a state that can flip at run time is a fact read by branches (`(tampered)`), not a domain variant; a
// variant by `overrides` is for a different kind of bot. Same mark-with-lifetime filter as the medic.
// Source: Space Station 14 (MIT), `HugBotCompound`, `HugNearbyCompound`, `HugBotHugCompound`,
// `HugBotFinishSpeakCompound` and the `NearbyNeedingHug` utility query in Resources/Prototypes/NPCs/hugbot.yml, at
// commit 614f030530578e248a2393dd71ee9813d68d800d:
// https://github.com/space-wizards/space-station-14/blob/614f030530578e248a2393dd71ee9813d68d800d/Resources/Prototypes/NPCs/hugbot.yml
// Licence: MIT, Copyright (c) 2017-2026 Space Wizards Federation; see src/examples/canon/THIRD_PARTY_NOTICES.md.
// Adapted (YAML prototypes re-written in our domain language).
// Emulations: the utility query (humanoids without a recent hug, by distance, accessible, in line of sight) is the
// host sensor `(wants_hug ?entity)` plus the `(not (recently_hugged ?e))` filter; SS14's `IsEmaggedPrecondition`
// is the fact `(tampered)`; `RaiseEventForOwnerOperator HugBotDidHugEvent` (which starts the hug cooldown) is
// `!mark_hugged`; `SetFloatOperator IdleTime 1` + `WaitOperator` is `!wait 1.0`.
// Deviations: SS14 picks the spoken lines at random from line sets; ours are one symbol per set.
// Not ported: the hug cooldown's length (the host's: it removes `recently_hugged`).
//
// Facts:      (wants_hug ?entity) host sensor, best first; (recently_hugged ?entity) mark, host-removed;
//             (tampered); (distance_to ?entity ?metres); idle's.
// Primitives: (!say ?line) (!move_near ?entity ?range) (!hug ?entity) (!melee_attack ?entity) (!wait ?seconds)
//             (!mark_hugged ?entity), idle's.

(:domain HugBot top_level_domain

    (:constants HugBotConstants overrides ServiceBot
        (approach_range 1.0)
    )

    (:axiom (job_target ?out_target) overrides ServiceBot
        (and
            (wants_hug ?out_target)
            (not (recently_hugged ?out_target))
        )
    )

    (:method (announce_approach ?inp_target) overrides ServiceBot

        (greet
            ()
            (
                (!say hug_start)
            )
        )
    )

    (:method (do_job ?inp_target) overrides ServiceBot

        (hug_and_part
            ()
            (
                (embrace ?inp_target)
                (!wait 1.0)
                (!mark_hugged ?inp_target)
                (parting_line)
            )
        )
    )

    // The touch: a hug, or a hit when tampered with.
    (:method (embrace ?inp_target)

        (hit
            (and
                (tampered)
            )
            (
                (!melee_attack ?inp_target)
            )
        )

        (hug
            ()
            (
                (!hug ?inp_target)
            )
        )
    )

    (:method (parting_line)

        (mean
            (and
                (tampered)
            )
            (
                (!say hug_finish_mean)
            )
        )

        (nice
            ()
            (
                (!say hug_finish_nice)
            )
        )
    )

    (:method (behave) top_level_method

        (bot
            ()
            (
                (run_bot)
            )
        )
    )
)
