// door_helper: at the box.
// method: behave
// expect: succeeded
//   1. !take r1 box
//   2. &fetch r1 box hall

self r1
robot r1
robot r2
door d1 hall room_a
door d1 room_a hall
route hall room_a room_a
route hall room_b room_a
