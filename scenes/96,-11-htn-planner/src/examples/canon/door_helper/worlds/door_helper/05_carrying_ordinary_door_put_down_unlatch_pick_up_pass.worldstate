// door_helper: carrying, ordinary door: put down, unlatch, pick up, pass.
// method: behave
// expect: succeeded
//   1. !put r1 box
//   2. !unlatch r1 d1
//   3. !take r1 box
//   4. !pass_door r1 d1 hall
//   5. &fetch r1 box hall

self r1
robot r1
robot r2
door d1 hall room_a
door d1 room_a hall
route hall room_a room_a
route hall room_b room_a
route room_a hall hall
route room_a room_b room_b
route room_b room_a room_a
route room_b hall room_a
job fetch box hall
status r1 free
status r2 free
at r1 room_a
at r2 room_b
holding r1 box
door_type d1 ordinary
