{
  "name": "mobile-qa-hub",
  "version": "1.0.0",
  "description": "QA hub for mobile (godot-explorer) issues/PRs deployed to a WORLD: one subscene folder per issue, listed in-world, mounted in isolation and unmounted when you leave",
  "license": "MIT",
  "scripts": {
    "start": "sdk-commands start",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "prestart": "npm run subscenes:gen",
    "prebuild": "npm run subscenes:gen",
    "predeploy": "node scripts/gen-subscenes.mjs && node scripts/check-world-name.mjs",
    "subscenes:gen": "node scripts/gen-subscenes.mjs",
    "subscenes:check": "node scripts/gen-subscenes.mjs --check",
    "typecheck": "tsc --noEmit",
    "deploy:check": "node scripts/check-world-name.mjs"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.30.1",
    "@dcl/sdk": "7.30.1",
    "typescript": "^5.5.4"
  }
}
