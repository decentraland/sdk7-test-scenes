{
  "name": "teleport-hub",
  "version": "1.0.0",
  "description": "Hub scene that teleports to the other test scenes of this world with the realm-aware teleportTo",
  "scripts": {
    "start": "sdk-commands start",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  },
  "devDependencies": {
    "@dcl/sdk": "^7.27.0",
    "@dcl/js-runtime": "7.27.0"
  }
}